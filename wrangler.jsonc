{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 프론트(dist 정적 파일)와 API(/api/*)를 Worker 하나로 배포한다.
  // 같은 주소에서 나가므로 로그인 쿠키가 인스타 앱 안 브라우저에서도 막히지 않고,
  // 나중에 실시간용 Durable Object 도 이 Worker 에 같이 넣을 수 있다.
  "name": "cat-island",
  "main": "api/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cat-island-db",
      // Cloudflare 에서 D1 을 만든 뒤 그 ID 를 여기에 적는다 (README.md 2단계).
      // 비워 두면 로컬 개발은 그대로 되고, 배포할 때는 wrangler 가 새로 만든다.
      "migrations_dir": "db/migrations"
    }
  ],
  "observability": { "enabled": true }
}
