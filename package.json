{
  "name": "cat-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "preview:cf": "vite build && wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && wrangler deploy",
    "seed:local": "node scripts/seed-local.mjs 64 > .wrangler/seed.sql && wrangler d1 execute DB --local --file .wrangler/seed.sql",
    "loadtest": "node scripts/loadtest.mjs 100 20"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
